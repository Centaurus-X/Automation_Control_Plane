# Bind to loopback unless an authenticated TLS reverse proxy is in front.
MCP_BIND_ADDRESS=127.0.0.1
MCP_HTTP_PORT=8080
MCP_CONTROLLER_IMAGE=automation-mcp-controller-server:0.1.0
AUTOMATION_SITE_ID=site-main
MASTER_INSTANCE_ID=master-01
# Use a dedicated broker identity in the integrated v0026 bundle.
MCP_MQTT_SOURCE_INSTANCE_ID=mcp-controller-01
MQTT_HOST=mqtt-broker
MQTT_PORT=8883
MQTT_SERVER_HOSTNAME=mqtt-broker
# Keep runtime secrets outside the immutable release directory.
MCP_MQTT_CA_SOURCE=/secure/mcp-controller/mqtt_ca.crt
MCP_MQTT_CERT_SOURCE=/secure/mcp-controller/mcp_mqtt.crt
MCP_MQTT_KEY_SOURCE=/secure/mcp-controller/mcp_mqtt.key
MCP_AUTH_SOURCE=/secure/mcp-controller/mcp_auth.json

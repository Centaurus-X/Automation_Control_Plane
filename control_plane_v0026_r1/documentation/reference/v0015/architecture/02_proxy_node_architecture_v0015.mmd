flowchart TB
    EXT["Client / Browser / API consumer"]

    subgraph LOOP["One Proxy process · one asyncio event loop"]
        subgraph WSS["Primary direct websockets listener · :8443"]
            HAND["TLS + exact Origin + Auth<br/>connection and frame limits"]
            EVENTS["/ws/v1/events<br/>subscribe · replay · filtered events"]
            CONTROL["/ws/v1/control<br/>command.request · correlation"]
            HAND --> EVENTS
            HAND --> CONTROL
        end

        subgraph HTTPS["Secondary Uvicorn listener · :8444"]
            REST["Starlette HTTP routes only<br/>Uvicorn ws=none"]
        end

        DISPATCH["Transport-neutral Command Dispatcher<br/>schema · rate limit · audit · idempotency"]
        AUTH["Identity and Policy<br/>Session · API token · CSRF · RBAC"]
        COMMANDS["Existing Command Gateway<br/>fixed Master actions only"]
        STREAM["Existing Event Stream<br/>bounded queues · coalescing · replay"]
        MQTT["Single MQTTS Gateway<br/>one proxy identity · QoS 1"]
        STORE[("PostgreSQL stores<br/>identity · audit · command state · replay")]

        CONTROL --> DISPATCH
        REST --> DISPATCH
        DISPATCH --> AUTH
        DISPATCH --> COMMANDS
        COMMANDS --> MQTT
        MQTT --> STREAM
        STREAM --> EVENTS
        AUTH <--> STORE
        DISPATCH <--> STORE
        STREAM <--> STORE
    end

    EXT -->|"WSS primary"| HAND
    EVENTS -->|"events and terminal results"| EXT
    CONTROL -->|"accepted / result"| EXT
    EXT -.->|"optional HTTPS"| REST
    MQTT <-->|"MQTTS mTLS"| BROKER[("Mosquitto")]

    NOTE["Port invariant<br/>Only websockets owns :8443.<br/>Uvicorn cannot share that socket."]
    NOTE -.-> WSS

    classDef boundary fill:#eff6ff,stroke:#2563eb,color:#0f172a,stroke-width:2px;
    classDef security fill:#fef2f2,stroke:#dc2626,color:#0f172a,stroke-width:2px;
    classDef service fill:#ecfdf5,stroke:#15803d,color:#0f172a,stroke-width:2px;
    classDef store fill:#faf5ff,stroke:#7e22ce,color:#0f172a,stroke-width:2px;
    classDef note fill:#fff7ed,stroke:#ea580c,color:#7c2d12,stroke-width:2px;
    class EXT,HAND,EVENTS,CONTROL,REST boundary;
    class AUTH security;
    class DISPATCH,COMMANDS,STREAM,MQTT service;
    class STORE,BROKER store;
    class NOTE note;

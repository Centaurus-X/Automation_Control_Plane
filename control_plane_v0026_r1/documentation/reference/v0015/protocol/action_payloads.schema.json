{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation.proxy.websocket.v1/action_payloads.schema.json",
  "title": "Automation Proxy WSS action and payload registry",
  "description": "Payload shape registry. Authorization and business validation remain in the shared dispatcher.",
  "oneOf": [
    {"$ref": "#/$defs/usersList"},
    {"$ref": "#/$defs/userCreate"},
    {"$ref": "#/$defs/rolesList"},
    {"$ref": "#/$defs/permissionsList"},
    {"$ref": "#/$defs/apiTokensList"},
    {"$ref": "#/$defs/apiTokensCreate"},
    {"$ref": "#/$defs/apiTokensRevoke"},
    {"$ref": "#/$defs/sitesList"},
    {"$ref": "#/$defs/nodesList"},
    {"$ref": "#/$defs/nodeGet"},
    {"$ref": "#/$defs/runtimeStatus"},
    {"$ref": "#/$defs/configGet"},
    {"$ref": "#/$defs/configHistory"},
    {"$ref": "#/$defs/configDiff"},
    {"$ref": "#/$defs/configPropose"},
    {"$ref": "#/$defs/configRollback"},
    {"$ref": "#/$defs/actuatorRequest"},
    {"$ref": "#/$defs/operationGet"},
    {"$ref": "#/$defs/auditList"},
    {"$ref": "#/$defs/nodeDrain"},
    {"$ref": "#/$defs/nodeStateSet"},
    {"$ref": "#/$defs/nodeAdmissionApprove"},
    {"$ref": "#/$defs/terminalExecute"}
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "siteScope": {
      "oneOf": [
        {"$ref": "#/$defs/identifier"},
        {"const": "*"}
      ]
    },
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "reason": {
      "type": ["string", "null"],
      "maxLength": 1024
    },
    "emptyPayload": {
      "type": "object",
      "additionalProperties": false
    },
    "boundedListPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"limit": {"$ref": "#/$defs/limit"}}
    },
    "rolloutTargets": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path"],
      "properties": {
        "operation": {
          "type": "string",
          "enum": ["set", "update", "append", "delete"]
        },
        "path": {"type": "string", "minLength": 1, "maxLength": 512},
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {"operation": {"const": "delete"}},
            "required": ["operation"]
          },
          "else": {"required": ["value"]}
        }
      ]
    },
    "usersList": {
      "type": "object",
      "properties": {
        "action": {"const": "users.list"},
        "payload": {"$ref": "#/$defs/boundedListPayload"}
      },
      "required": ["action", "payload"]
    },
    "userCreate": {
      "type": "object",
      "properties": {
        "action": {"const": "user.create"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["username", "password"],
          "properties": {
            "username": {"type": "string", "minLength": 1, "maxLength": 256},
            "password": {"type": "string", "minLength": 1, "maxLength": 4096},
            "display_name": {"type": ["string", "null"], "maxLength": 512},
            "email": {"type": ["string", "null"], "maxLength": 512},
            "enabled": {"type": "boolean"},
            "role_name": {"type": ["string", "null"], "maxLength": 128},
            "site_id": {"$ref": "#/$defs/identifier"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "rolesList": {
      "type": "object",
      "properties": {
        "action": {"const": "roles.list"},
        "payload": {"$ref": "#/$defs/emptyPayload"}
      },
      "required": ["action", "payload"]
    },
    "permissionsList": {
      "type": "object",
      "properties": {
        "action": {"const": "permissions.list"},
        "payload": {"$ref": "#/$defs/emptyPayload"}
      },
      "required": ["action", "payload"]
    },
    "apiTokensList": {
      "type": "object",
      "properties": {
        "action": {"const": "api_tokens.list"},
        "payload": {"$ref": "#/$defs/boundedListPayload"}
      },
      "required": ["action", "payload"]
    },
    "apiTokensCreate": {
      "type": "object",
      "properties": {
        "action": {"const": "api_tokens.create"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 256},
            "permissions": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 128}
            },
            "site_scopes": {
              "type": "array",
              "maxItems": 128,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/siteScope"}
            },
            "expires_at": {"type": ["string", "null"], "format": "date-time"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "apiTokensRevoke": {
      "type": "object",
      "properties": {
        "action": {"const": "api_tokens.revoke"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["token_id"],
          "properties": {"token_id": {"$ref": "#/$defs/uuid"}}
        }
      },
      "required": ["action", "payload"]
    },
    "sitesList": {
      "type": "object",
      "properties": {
        "action": {"const": "sites.list"},
        "payload": {"$ref": "#/$defs/emptyPayload"}
      },
      "required": ["action", "payload"]
    },
    "nodesList": {
      "type": "object",
      "properties": {
        "action": {"const": "nodes.list"},
        "payload": {"$ref": "#/$defs/emptyPayload"}
      },
      "required": ["action", "payload"]
    },
    "nodeGet": {
      "type": "object",
      "properties": {
        "action": {"const": "node.get"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id"],
          "properties": {"node_id": {"$ref": "#/$defs/identifier"}}
        }
      },
      "required": ["action", "payload"]
    },
    "runtimeStatus": {
      "type": "object",
      "properties": {
        "action": {"const": "runtime.status"},
        "payload": {"$ref": "#/$defs/emptyPayload"}
      },
      "required": ["action", "payload"]
    },
    "configGet": {
      "type": "object",
      "properties": {
        "action": {"const": "config.get"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "revision": {"type": "integer", "minimum": 1}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "configHistory": {
      "type": "object",
      "properties": {
        "action": {"const": "config.history"},
        "payload": {"$ref": "#/$defs/boundedListPayload"}
      },
      "required": ["action", "payload"]
    },
    "configDiff": {
      "type": "object",
      "properties": {
        "action": {"const": "config.diff"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from_revision", "to_revision"],
          "properties": {
            "from_revision": {"type": "integer", "minimum": 1},
            "to_revision": {"type": "integer", "minimum": 1}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "configPropose": {
      "type": "object",
      "properties": {
        "action": {"const": "config.propose"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_revision", "changes"],
          "properties": {
            "base_revision": {"type": "integer", "minimum": 0},
            "changes": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"$ref": "#/$defs/change"}
            },
            "reason": {"$ref": "#/$defs/reason"},
            "rollout_targets": {"$ref": "#/$defs/rolloutTargets"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "configRollback": {
      "type": "object",
      "properties": {
        "action": {"const": "config.rollback"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["base_revision", "target_revision"],
          "properties": {
            "base_revision": {"type": "integer", "minimum": 1},
            "target_revision": {"type": "integer", "minimum": 1},
            "reason": {"$ref": "#/$defs/reason"},
            "rollout_targets": {"$ref": "#/$defs/rolloutTargets"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "actuatorRequest": {
      "type": "object",
      "properties": {
        "action": {"const": "actuator.request"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controller_uuid", "actuator_id", "value"],
          "properties": {
            "controller_uuid": {"$ref": "#/$defs/uuid"},
            "actuator_id": {
              "oneOf": [
                {"type": "integer"},
                {"type": "string", "minLength": 1, "maxLength": 128}
              ]
            },
            "value": {},
            "idempotent": {"type": "boolean"},
            "device_command_id_supported": {"type": "boolean"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "operationGet": {
      "type": "object",
      "properties": {
        "action": {"const": "operation.get"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation_id"],
          "properties": {
            "operation_id": {"$ref": "#/$defs/uuid"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "auditList": {
      "type": "object",
      "properties": {
        "action": {"const": "audit.list"},
        "payload": {"$ref": "#/$defs/boundedListPayload"}
      },
      "required": ["action", "payload"]
    },
    "nodeDrain": {
      "type": "object",
      "properties": {
        "action": {"const": "node.drain"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id"],
          "properties": {
            "node_id": {"$ref": "#/$defs/identifier"},
            "reason": {"$ref": "#/$defs/reason"},
            "deadline_s": {"type": "number", "minimum": 0, "maximum": 86400}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "nodeStateSet": {
      "type": "object",
      "properties": {
        "action": {"const": "node.state.set"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id", "desired_state"],
          "properties": {
            "node_id": {"$ref": "#/$defs/identifier"},
            "desired_state": {
              "type": "string",
              "enum": ["ACTIVE", "DRAINING", "MAINTENANCE", "QUARANTINED"]
            },
            "reason": {"$ref": "#/$defs/reason"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "nodeAdmissionApprove": {
      "type": "object",
      "properties": {
        "action": {"const": "node.admission.approve"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["node_id"],
          "properties": {
            "node_id": {"$ref": "#/$defs/identifier"},
            "certificate_identity": {"type": ["string", "null"], "maxLength": 512},
            "reason": {"$ref": "#/$defs/reason"}
          }
        }
      },
      "required": ["action", "payload"]
    },
    "terminalExecute": {
      "type": "object",
      "properties": {
        "action": {"const": "terminal.execute"},
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command"],
          "properties": {
            "command": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
            }
          }
        }
      },
      "required": ["action", "payload"]
    }
  }
}

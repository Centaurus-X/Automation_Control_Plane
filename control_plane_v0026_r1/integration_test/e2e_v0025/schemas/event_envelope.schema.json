{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "automation.control.v1/event_envelope.schema.json",
  "title": "Existing v0014 automation.control.v1 event envelope on WSS",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol", "schema_version", "message_id", "correlation_id",
    "event_type", "source", "target", "site_id", "issued_at",
    "expires_at", "authority_term", "config_revision", "payload"
  ],
  "properties": {
    "protocol": {"const": "automation.control.v1"},
    "schema_version": {"const": 1},
    "message_id": {"type": "string", "format": "uuid"},
    "correlation_id": {"type": "string", "format": "uuid"},
    "causation_id": {"type": ["string", "null"], "format": "uuid"},
    "idempotency_key": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "event_type": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{1,127}$"},
    "source": {"$ref": "#/$defs/serviceIdentity"},
    "target": {"$ref": "#/$defs/serviceIdentity"},
    "site_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "principal": {"type": ["object", "null"]},
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "authority_term": {"type": "integer", "minimum": 0},
    "config_revision": {"type": "integer", "minimum": 0},
    "payload": {"type": "object"},
    "extensions": {
      "type": "object",
      "properties": {
        "replay_sequence": {"type": "integer", "minimum": 0},
        "live_sequence": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "serviceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "instance_id"],
      "properties": {
        "service": {"type": "string", "enum": ["master", "proxy", "worker", "monitoring"]},
        "instance_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"}
      }
    }
  }
}

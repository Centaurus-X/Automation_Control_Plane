{
  "schema_version": 2,
  "component_id": "automation-fleet",
  "providers": ["linux_systemd", "docker_compose", "kubernetes_helm", "gitops_argocd", "gitops_flux"],
  "dependencies": {"hard_deploy": [], "hard_runtime": [], "soft_runtime": [], "management": [], "observability": ["observability"]},
  "placement_contract": {"required_capabilities": ["network-policy", "persistent-storage"]},

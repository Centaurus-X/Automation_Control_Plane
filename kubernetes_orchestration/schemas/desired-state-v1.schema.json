{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automation:fleet:desired-state:v1",
  "title": "Automation Fleet Desired State v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deployment_id", "release_ref", "placement", "components", "rollout"],
  "properties": {
    "schema_version": {"const": 1},
    "deployment_id": {"$ref": "#/$defs/id"},
    "release_ref": {"type": "string", "minLength": 1},
    "placement": {
      "type": "object", "additionalProperties": false,
      "oneOf": [
        {"required": ["target_ids"], "properties": {"target_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}},
        {"required": ["selector"], "properties": {"selector": {"$ref": "#/$defs/selector"}}}
      ]
    },
    "components": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object", "additionalProperties": false, "required": ["enabled", "values"], "properties": {"enabled": {"type": "boolean"}, "values": {"type": "object"}}}},
    "rollout": {"type": "object", "additionalProperties": false, "required": ["strategy", "max_parallel", "stop_on_failure", "approval_per_wave", "canary_per_failure_domain"], "properties": {"strategy": {"const": "waves"}, "max_parallel": {"const": 1}, "stop_on_failure": {"const": true}, "approval_per_wave": {"type": "boolean"}, "canary_per_failure_domain": {"type": "boolean"}}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"},
    "selector": {"type": "object", "additionalProperties": false, "properties": {"target_kind": {"const": "kubernetes"}, "site_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "cluster_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "failure_domains": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "required_capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "execution_modes": {"type": "array", "uniqueItems": true, "items": {"enum": ["direct", "agent"]}}, "write_owners": {"type": "array", "uniqueItems": true, "items": {"enum": ["helm", "gitops_argocd", "gitops_flux", "observe_only"]}}, "match_labels": {"type": "object", "additionalProperties": {"type": "string"}}, "max_targets": {"type": "integer", "minimum": 1, "maximum": 1000}}}
  }
}

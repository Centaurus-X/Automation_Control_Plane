{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automation:fleet:inventory:v2",
  "title": "Automation Fleet Inventory v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "environment_id", "targets"],
  "properties": {"schema_version": {"const": 2}, "environment_id": {"$ref": "#/$defs/id"}, "targets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/target"}}},
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"},
    "target": {"type": "object", "additionalProperties": false, "required": ["target_id", "target_kind", "site_id", "cluster_id", "context", "namespace", "write_owner", "capabilities"], "properties": {
      "target_id": {"$ref": "#/$defs/id"}, "target_kind": {"const": "kubernetes"}, "site_id": {"$ref": "#/$defs/id"}, "cluster_id": {"$ref": "#/$defs/id"}, "failure_domain": {"$ref": "#/$defs/id", "description": "Defaults to cluster_id when omitted."}, "context": {"type": "string", "minLength": 1, "maxLength": 253}, "namespace": {"$ref": "#/$defs/id"},
      "write_owner": {"enum": ["helm", "gitops_argocd", "gitops_flux", "observe_only"]}, "execution_mode": {"enum": ["direct", "agent"], "default": "direct"}, "wave": {"type": "integer", "minimum": 0, "maximum": 9999}, "agent_task_timeout_s": {"type": "integer", "minimum": 30, "maximum": 7200},
      "capabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "labels": {"type": "object", "additionalProperties": {"type": "string"}},
      "gitops": {"type": "object", "additionalProperties": false, "required": ["worktree", "relative_path", "branch", "remote", "push", "reconciler_name", "reconciler_namespace"], "properties": {"worktree": {"type": "string"}, "relative_path": {"type": "string"}, "branch": {"type": "string"}, "remote": {"type": "string"}, "push": {"type": "boolean"}, "reconciler_name": {"$ref": "#/$defs/id"}, "reconciler_namespace": {"$ref": "#/$defs/id"}}}
    }}
  }
}

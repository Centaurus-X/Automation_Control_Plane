{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:automation:fleet:component-descriptor:v2",
  "title": "Automation Component Descriptor v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "component_id", "providers", "dependencies", "placement_contract", "health_contract", "security_contract"],
  "properties": {
    "schema_version": {"const": 2},
    "component_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]+$"},
    "providers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["kubernetes_helm", "gitops_argocd", "gitops_flux", "docker_compose", "linux_systemd"]}},
    "dependencies": {
      "type": "object",
      "required": ["hard_deploy", "hard_runtime", "soft_runtime", "management", "observability"],
      "additionalProperties": false,
      "properties": {
        "hard_deploy": {"type": "array", "items": {"type": "string"}},
        "hard_runtime": {"type": "array", "items": {"type": "string"}},
        "soft_runtime": {"type": "array", "items": {"type": "string"}},
        "management": {"type": "array", "items": {"type": "string"}},
        "observability": {"type": "array", "items": {"type": "string"}}
      }
    },
    "placement_contract": {"type": "object", "additionalProperties": false, "required": ["required_capabilities"], "properties": {"required_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "health_contract": {"type": "object"},
    "security_contract": {"type": "object"},
    "rollback_contract": {"type": "object"},
    "runtime_profiles": {"type": "array", "items": {"type": "string"}}
  }
}
